# Postgres URL — Railway la inyecta automáticamente cuando agregas el plugin "PostgreSQL"
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Puerto — Railway lo inyecta como $PORT, en local default 3001
PORT=3001

# Orígenes permitidos por CORS (coma-separado). En prod pon el dominio de Vercel.
# Ejemplo: https://quicesiaproyect.vercel.app,http://localhost:5173
CORS_ORIGINS=*
